Algoritmo PositivoNegaticoCero
	Definir nume Como Real

	Escribir "Ingresa un número"
	Leer nume
	si nume > 0 Entonces
		Escribir "el número es positivo"
	SiNo
		si nume < 0 Entonces
			Escribir "el número es negativo"
		SiNo
			Escribir "el número es cero"
		FinSi
	FinSi
FinAlgoritmo
